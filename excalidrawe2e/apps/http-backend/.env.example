# Object storage. LocalStack locally, Cloudflare R2 or AWS S3 in production -
# the same code reads all three, so switching providers is this file and
# nothing else. See src/storage.ts for the per-provider values.
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET=whiteboard-images
# LocalStack accepts any credentials; R2 and S3 want real ones
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
# where browsers read objects from; a CDN domain in production
STORAGE_PUBLIC_BASE=http://localhost:4566/whiteboard-images

# Must match ws-backend: both read it through @repo/backend-common, and a
# mismatch shows up as tokens that sign fine here and fail to verify there.
# Left unset in development so both fall back to the same shared default.
# JWT_SECRET=
